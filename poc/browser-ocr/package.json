{
  "name": "local-ocr-browser-poc",
  "version": "0.0.0",
  "description": "Completely offline Local OCR technology validation PoC",
  "author": "Local OCR Project",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "stage:assets": "node ./scripts/stage-assets.mjs",
    "verify:assets": "node ./scripts/verify-staged-assets.mjs",
    "verify:build-assets": "node ./scripts/verify-built-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "build": "node ./scripts/verify-staged-assets.mjs && vite build && npm run build:electron && npm run verify:build-assets",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package:portable": "npm run build && electron-builder --win portable --x64 --config electron-builder.yml && npm run verify:portable",
    "verify:portable": "node ./scripts/verify-portable.mjs",
    "start:electron": "electron .",
    "pretest:e2e": "npm run build",
    "test:e2e": "set NO_PROXY=127.0.0.1,localhost&& set no_proxy=127.0.0.1,localhost&& playwright test",
    "pretest:e2e:offline": "npm run build",
    "test:e2e:offline": "set NO_PROXY=127.0.0.1,localhost&& set no_proxy=127.0.0.1,localhost&& playwright test --config playwright.offline.config.ts",
    "pretest:e2e:electron": "npm run build",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "test:e2e:portable": "npm run verify:portable && node ./scripts/test-portable-ocr.mjs",
    "test:e2e:portable-paths": "npm run verify:portable && node ./scripts/test-portable-paths.mjs",
    "measure:full-hd": "node ./scripts/measure-full-hd.mjs --preset full-hd",
    "measure:a4": "node ./scripts/measure-full-hd.mjs --preset a4",
    "test:continuous-ocr": "node ./scripts/test-continuous-ocr.mjs",
    "generate:evaluation-set": "node ./scripts/generate-evaluation-set.mjs",
    "pretest:evaluate:cer": "npm run build && npm run generate:evaluation-set",
    "test:evaluate:cer": "playwright test --config playwright.cer.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@playwright/test": "1.62.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "onnxruntime-web": "1.27.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
